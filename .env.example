# Copy to `.env` and fill in. The binaries read it from the workspace root
# before they parse their command lines, so every variable here is a default a
# flag can still override — `--help` on either binary lists both spellings.
#
# `.env` is in `.gitignore` and stays there: the only thing it holds is where
# one operator's client install lives, and no path to anyone's machine is ever
# committed. See docs/client_versions.md for how to obtain an install legally.

# The client install both the shard and the window read. Required.
OPENSHARD_CLIENT=/path/to/Ultima Online Classic

# Only openshard-client-app reads these, and only to log in. Without an account
# it is an offline map viewer. The playground has a shard of its own and takes
# the development account from it.
#OPENSHARD_ACCOUNT=admin
#OPENSHARD_PASSWORD=
#OPENSHARD_SERVER=127.0.0.1:2593
#OPENSHARD_CHARACTER=Lord British

# The tracing filter, if `info` is not what you want.
#RUST_LOG=info
